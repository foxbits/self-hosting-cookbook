# ============================================
# Backup stack (backup)
# ============================================
# Copy to .env and fill in real values: cp .env.default .env
# Every variable is documented in README.md (Environment variables).

# --- Schedule ---
BACKUP_SCHEDULE_ENABLED=false
BACKUP_CRON="30 3 * * *"
BACKUP_TIMEZONE=Europe/Bucharest
# Start with actual only, then use the full list:
# configs actual arr-stack datastore-sql fusionauth immich luna opencloud portainer vaultwarden agents-stack
BACKUP_SERVICES="actual"

# --- Notifications ---
BACKUP_NOTIFY_ENABLED=true
BACKUP_NOTIFY_ON_SUCCESS=true
APPRISE_DISCORD_URL=discord://CHANGE_ME/CHANGE_ME

# --- Restic repository ---
RESTIC_REPOSITORY=rclone:icloud:Backups/self-hosting-cookbook/restic
# generate with: openssl rand -base64 32
RESTIC_PASSWORD=CHANGE_ME_generate_with_openssl_rand_base64_32
# optional; restic defaults to 16 MiB. Raise carefully for iCloud.
#RESTIC_PACK_SIZE=32

# --- PostgreSQL ---
BACKUP_PG_HOST=datastore-sql
BACKUP_PG_PORT=5432
BACKUP_PG_USER=postgres
# must match POSTGRES_PASSWORD in datastore-sql/.env
BACKUP_PG_PASSWORD=CHANGE_ME_must_match_datastore_sql

# --- Docker host ---
BACKUP_DOCKER_VOLUMES_PATH=/var/lib/docker/volumes
BACKUP_HOST=home-lab

# --- External source paths (must match the service .env) ---
# must match UPLOAD_LOCATION in immich/.env
BACKUP_IMMICH_UPLOADS=/mnt/sda4/photos
# must match SH_OC_CONFIG_DIR in opencloud/.env
BACKUP_OPENCLOUD_CONFIG=/mnt/sda4/opencloud/config
# must match SH_OC_DATA_DIR in opencloud/.env
BACKUP_OPENCLOUD_DATA=/mnt/sda4/opencloud/data

# --- Named volumes (verify with: docker volume ls) ---
BACKUP_FUSIONAUTH_VOLUME=fusionauth_fusionauth_config
BACKUP_LUNA_VOLUME=luna_openwebui-data
BACKUP_PORTAINER_VOLUME=portainer_data
BACKUP_CAMOFOX_PROFILES_VOLUME=agents-stack_camofox-profiles
BACKUP_GPT_RESEARCHER_VOLUME=agents-stack_gpt-researcher-data

# --- Retention ---
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=12

# --- Integrity check ---
BACKUP_CHECK_ENABLED=true
BACKUP_CHECK_CRON="0 4 * * 0"
BACKUP_CHECK_READ_DATA_PERCENT=1
