# ============================================
# Backup stack (backup)
# ============================================
# Copy to .env and fill in real values: cp .env.default .env
# Every variable is documented in README.md (Environment variables).

# --- Schedule ---
BACKUP_SCHEDULE_ENABLED=false
BACKUP_CRON="30 3 * * *"
BACKUP_TIMEZONE=Europe/Bucharest
BACKUP_SERVICES="actual"

# --- Notifications ---
BACKUP_NOTIFY_ENABLED=true
BACKUP_NOTIFY_ON_SUCCESS=true
APPRISE_DISCORD_URL=discord://CHANGE_ME/CHANGE_ME

# --- Restic repository ---
RESTIC_REPOSITORY=rclone:icloud:Backups/self-hosting-cookbook/restic
# generate with: openssl rand -base64 32
RESTIC_PASSWORD=CHANGE_ME_generate_with_openssl_rand_base64_32
# optional; restic defaults to 16 MiB. Raise carefully for iCloud.
#RESTIC_PACK_SIZE=32

# --- Snapshot label ---
BACKUP_HOST=home-lab

# --- Retention ---
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=12

# --- Integrity check ---
BACKUP_CHECK_ENABLED=true
BACKUP_CHECK_CRON="0 4 * * 0"
BACKUP_CHECK_READ_DATA_PERCENT=1
