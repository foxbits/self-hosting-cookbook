# SearXNG (see README "Environment variables" for what each key does)
DEBUG=false
LIMITER_ENABLED=false
SEARXNG_REDIS_URL=redis://datastore-memory:6379/0
FORCE_OWNERSHIP=true
LOG_LEVEL=info
SEARXNG_INSTANCE_NAME="My SearXNG"
SEARXNG_BASE_URL=http://your-server:9704/
LOCALE=en
COUNTRY_CODE=US
# generate with: openssl rand -hex 32
SEARXNG_SECRET=CHANGE_ME_openssl_rand_hex_32
WOLFRAM_DISABLED=true
WOLFRAM_API_KEY=YOUR_WOLFRAM_API_KEY

# Crawl4AI
MAX_CONCURRENT_TASKS=10
CRAWL4AI_API_TOKEN=YOUR_TOKEN

# GPT Researcher
GPT_RESEARCHER_PATH=../../repos/better-gpt-researcher
LANGUAGE="english"
RETRIEVER=searx
SEARX_URL=http://searxng:8080
SCRAPER=crawl4ai
OPENCRAWL_PATH=../../repos/open-crawl
CRAWL4AI_API_URL=http://crawl4ai:11235
OPENAI_API_KEY=YOUR_API_KEY
OPENAI_BASE_URL=https://router.your-provider.ai/v1
FAST_LLM=openai:policy/gpt-oss-20b
SMART_LLM=openai:policy/deepseek-v4-pro
SMART_TOKEN_LIMIT=32000
STRATEGIC_LLM=openai:policy/deepseek-v4-flash
EMBEDDING=openai:openai/text-embedding-3-small
MIN_RAW_CONTENT_LENGTH=200

# Camofox (fork build)
CAMOFOX_BROWSER_PATH=../../repos/camofox-browser
CAMOUFOX_VERSION=152.0.4
CAMOUFOX_RELEASE=beta.29
# generate with: openssl rand -hex 32
CAMOFOX_ACCESS_KEY=CHANGE_ME_openssl_rand_hex_32
CAMOFOX_API_KEY=CHANGE_ME_openssl_rand_hex_32
CAMOFOX_ADMIN_KEY=CHANGE_ME_openssl_rand_hex_32
CAMOFOX_LOCALES=ro-RO,ro,en-US,en
CAMOFOX_TIMEZONE=Europe/Bucharest
# must match CAMOFOX_TIMEZONE
TZ=Europe/Bucharest
CAMOFOX_LATITUDE=47.1511
CAMOFOX_LONGITUDE=27.5879
#PROXY_HOST=browser-proxy
#PROXY_PORT=8888
CAMOFOX_PROFILE_DIR=/data/profiles
CAMOFOX_TRACES_DIR=/data/traces
CAMOFOX_COOKIES_DIR=/data/cookies
CAMOFOX_UPLOADS_DIR=/data/uploads
CAMOFOX_CRASH_REPORT_ENABLED=false
MAX_SESSIONS=10
MAX_TABS_PER_SESSION=5
MAX_TABS_GLOBAL=12
SESSION_TIMEOUT_MS=1800000
TAB_INACTIVITY_MS=300000
BROWSER_IDLE_TIMEOUT_MS=0
HANDLER_TIMEOUT_MS=30000
NAVIGATE_TIMEOUT_MS=25000
MAX_CONCURRENT_PER_USER=3
MAX_OLD_SPACE_SIZE=256

# Image generation
IMAGE_GENERATION_PROVIDER=openai
IMAGE_GENERATION_ENABLED=False
IMAGE_GENERATION_MODEL=google/gemini-3.1-flash-image-preview
IMAGE_GENERATION_API_KEY=YOUR_API_KEY
IMAGE_GENERATION_BASE_URL=https://router.your-provider.ai/v1
IMAGE_GENERATION_MAX_IMAGES=1
