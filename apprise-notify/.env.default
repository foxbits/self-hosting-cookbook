# ============================================
# Apprise API Configuration (apprise-notify)
# ============================================
# Reference: https://appriseit.com/api/deployment/

# --- Core Apprise API env vars ---
APPRISE_STATEFUL_MODE=simple  # 'simple' enables both stateless ('POST /notify')
                              # and stateful ('POST /notify/{KEY}') usage.
                              # Change to 'legacy' only if you need the old key DB.
APPRISE_WORKER_COUNT=1
APPRISE_ADMIN=y               # 'y' enables the optional web UI at http://<host>:9862/

# Optional: serve the API under a subpath behind a reverse proxy.
# Leave empty (default) when accessed directly on port 8000.
#APPRISE_BASE_URL=/apprise

# --- Optional file ownership (default omits; container runs as root otherwise) ---
PUID=1000
PGID=1000
