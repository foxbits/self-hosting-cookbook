## OpenCloud + Euro Office (external-proxy, built-in LDAP, Romanian/English) ##
## All vars use container-native names and are loaded via `env_file: - .env` in docker-compose.yml.

# --- Domains (served by YOUR reverse proxy; TLS terminated there) ---
OC_DOMAIN=cloud.opencloud.test
EURO_OFFICE_DOMAIN=euro-office.opencloud.test

# --- Identity (built-in LDAP / idm) ---
# Admin password. Set BEFORE first start; cannot be changed via env afterward (use OpenCloud UI/CLI).
IDM_ADMIN_PASSWORD=CHANGE_ME
IDM_CREATE_DEMO_USERS=false

# TLS validation. true = skip cert validation (for self-signed/local proxy); false = validate (trusted proxy).
OC_INSECURE=true

# Default WebUI language (ISO 639-1)
# Both are always available; users can switch individually.
OC_DEFAULT_LANGUAGE=en

# Basic auth for WebDAV clients that don't support OIDC (not recommended).
PROXY_ENABLE_BASIC_AUTH=false

# --- OpenCloud image (rolling channel; for production set OC_DOCKER_IMAGE=opencloudeu/opencloud + a stable tag) ---
OC_DOCKER_IMAGE=opencloudeu/opencloud-rolling
OC_DOCKER_TAG=latest
OC_CONTAINER_UID_GID=1000:1000

# --- Persistent storage (bind mounts, must be owned 1000:1000; `make init-storage` creates them) ---
OC_CONFIG_DIR=/mnt/sda4/opencloud/config
OC_DATA_DIR=/mnt/sda4/opencloud/data
OC_APPS_DIR=./config/opencloud/apps

# --- Euro Office (Romanian ro_RO + English en_* dictionaries bundled in the image) ---
EURO_OFFICE_DOCKER_IMAGE=ghcr.io/euro-office/documentserver
EURO_OFFICE_DOCKER_TAG=latest
# Optional JWT hardening (NOT wired by default — see README). Uncomment + add `JWT_SECRET: ${EURO_OFFICE_JWT_SECRET}`
# to the euro-office service environment block to pin a known secret.
#EURO_OFFICE_JWT_SECRET=CHANGE_ME   # generate with: openssl rand -hex 32

# --- Services / logging ---
# Additional services to start (comma-separated, e.g. "notifications,antivirus"). collaboration is always added.
START_ADDITIONAL_SERVICES=
OC_LOG_LEVEL=info
OC_LOG_PRETTY=false
OC_LOG_COLOR=false
LOG_DRIVER=local

# --- Frontend / sharing ---
FRONTEND_CHECK_FOR_UPDATES=true
OC_SHARING_PUBLIC_SHARE_MUST_HAVE_PASSWORD=false
OC_SHARING_PUBLIC_WRITEABLE_SHARE_MUST_HAVE_PASSWORD=false

# --- Password policy ---
OC_PASSWORD_POLICY_DISABLED=false
OC_PASSWORD_POLICY_MIN_CHARACTERS=12
OC_PASSWORD_POLICY_MIN_LOWERCASE_CHARACTERS=1
OC_PASSWORD_POLICY_MIN_UPPERCASE_CHARACTERS=1
OC_PASSWORD_POLICY_MIN_DIGITS=1
OC_PASSWORD_POLICY_MIN_SPECIAL_CHARACTERS=1

# --- Optional SMTP (leave blank to disable; add 'notifications' to START_ADDITIONAL_SERVICES to enable) ---
NOTIFICATIONS_SMTP_HOST=
NOTIFICATIONS_SMTP_PORT=
NOTIFICATIONS_SMTP_SENDER=OpenCloud Notifications <notifications@cloud.opencloud.test>
NOTIFICATIONS_SMTP_USERNAME=
NOTIFICATIONS_SMTP_PASSWORD=CHANGE_ME
NOTIFICATIONS_SMTP_AUTHENTICATION=
NOTIFICATIONS_SMTP_ENCRYPTION=none
NOTIFICATIONS_SMTP_INSECURE=false
